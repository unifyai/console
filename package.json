{
  "name": "console",
  "private": true,
  "engines": {
    "node": ">=20.19 <23",
    "npm": ">=10"
  },
  "scripts": {
    "generate:api": "openapi-typescript https://api.unify.ai/v0/openapi.json -o src/lib/orchestra/schema.d.ts",
    "predev": "node scripts/guard-next-live-stack.mjs predev",
    "dev": "next dev",
    "dev:mock": "NEXT_PUBLIC_MOCK_SIM=true npm run dev",
    "prebuild": "node scripts/guard-next-live-stack.mjs prebuild",
    "build": "npm run check:styles:all && next build",
    "build:mock": "NEXT_PUBLIC_MOCK_SIM=true npm run build",
    "start": "next start",
    "start:mock": "NEXT_PUBLIC_MOCK_SIM=true npm run start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "ci": "npm run lint && npm run typecheck && npm run format:check && npm run check:styles:all && npm run build",
    "ci:live-safe": "npm run lint && npm run typecheck && npm run format:check && npm run check:styles:all",
    "prepare": "husky",
    "test:node": "vitest --project node",
    "test:node:matrix": "bash src/tests/scripts/test-node-matrix.sh",
    "test:browser": "vitest --project browser",
    "test:browser:matrix": "bash src/tests/scripts/test-browser-matrix.sh",
    "test:browser:generate": "npx tsx src/tests/scripts/generate-split-tests.ts",
    "test:browser:screenshots": "VITE_TAKE_SCREENSHOTS=true vitest --project browser",
    "test:interfaces": "vitest --project node src/tests/interfaces",
    "test:interfaces:real": "npm run dev & DEV_PID=$!; sleep 10 && npm run test:interfaces; EXIT_CODE=$?; kill $DEV_PID 2>/dev/null; exit $EXIT_CODE",
    "test:interfaces:browser": "vitest --project browser src/tests/interfaces",
    "test:real": "vitest --project real",
    "check:fonts": "npx tsx scripts/check-font-classes.ts",
    "check:fonts:all": "npx tsx scripts/check-font-classes.ts",
    "check:colors": "npx tsx scripts/check-colors.ts",
    "check:colors:all": "npx tsx scripts/check-colors.ts",
    "check:styles": "npm run check:fonts && npm run check:colors",
    "check:styles:all": "npm run check:fonts:all && npm run check:colors:all",
    "check:test-coverage": "tsx scripts/check-test-coverage-map.ts",
    "check:test-inventory": "tsx scripts/check-test-inventory-sync.ts"
  },
  "lint-staged": {
    "package.json": "prettier --write",
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0",
      "npx tsx scripts/check-font-classes.ts",
      "npx tsx scripts/check-colors.ts"
    ],
    "*.{json,md,yml,yaml,css,scss}": "prettier --write"
  },
