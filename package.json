{
  "name": "console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "ci": "npm run lint && npm run typecheck && npm run format:check && npm run build",
    "prepare": "husky",
    "test:node": "vitest --project node",
    "test:node:matrix": "bash src/tests/scripts/test-node-matrix.sh",
    "test:browser": "vitest --project browser",
    "test:browser:matrix": "bash src/tests/scripts/test-browser-matrix.sh",
    "test:browser:generate": "npx tsx src/tests/scripts/generate-split-tests.ts",
    "test:browser:screenshots": "VITE_TAKE_SCREENSHOTS=true vitest --project browser",
    "test:interfaces": "vitest --project node src/tests/interfaces",
    "test:interfaces:real": "npm run dev & DEV_PID=$!; sleep 10 && npm run test:interfaces; EXIT_CODE=$?; kill $DEV_PID 2>/dev/null; exit $EXIT_CODE",
    "test:interfaces:browser": "vitest --project browser src/tests/interfaces",
    "test:real": "vitest --project real"
  },
  "lint-staged": {
    "package.json": "prettier --write",
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,md,yml,yaml,css,scss}": "prettier --write"
  },
