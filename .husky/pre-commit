#!/bin/sh

# Secret scanning on staged changes — keeps API keys, tokens and private keys
# out of the history. Runs first so a leak fails the commit before the slower
# checks below. Install with: brew install gitleaks
echo "🔍 Scanning staged changes for secrets..."
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "❌ gitleaks is not installed. Install it with 'brew install gitleaks'."
  echo "   Secret scanning is required — do not bypass with --no-verify."
  exit 1
fi
if gitleaks git --help >/dev/null 2>&1; then
  GITLEAKS_SCAN="gitleaks git --staged --redact --no-banner"
else
  GITLEAKS_SCAN="gitleaks protect --staged --redact --no-banner"
fi
$GITLEAKS_SCAN || {
  echo "❌ Potential secret detected in staged changes. Remove it and rotate the credential."
  exit 1
}

# Run TypeScript check (entire project)
echo "🔍 Running TypeScript check..."
npx tsc --noEmit || {
  echo "❌ TypeScript errors found. Fix them before committing."
  exit 1
}

# Check for critical vulnerabilities when dependencies change
if git diff --cached --name-only | grep -q 'package-lock.json'; then
  echo "🔍 Checking for critical npm vulnerabilities..."
  npm audit --audit-level=critical --omit=dev 2>/dev/null || {
    echo "❌ Critical npm vulnerabilities detected. Run 'npm audit' for details."
    exit 1
  }
fi

# AGENTS.md must match its sources under .agents/
if git diff --cached --name-only | grep -qE '^(\.agents/|AGENTS\.md$)'; then
  if [ -f .agents/global-rules/build_agents_md.py ]; then
    echo "🔍 Checking AGENTS.md is up to date..."
    python3 .agents/global-rules/build_agents_md.py --check || exit 1
  else
    echo "⏭️  Shared-rules submodule not checked out; skipping AGENTS.md check"
  fi
fi

# Run lint-staged (prettier, eslint, fonts, colors on staged files)
npx lint-staged
