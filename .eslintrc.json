{
  "root": true,
  "extends": ["next/core-web-vitals", "prettier"],
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint"],
  "rules": {
    "react/no-unescaped-entities": "off",
    "@typescript-eslint/naming-convention": [
      "error",
      {
        "selector": "variable",
        "format": ["camelCase", "PascalCase", "UPPER_CASE"],
        "leadingUnderscore": "allow",
        "filter": {
          "regex": "^__[a-zA-Z]+__$",
          "match": false
        }
      },
      {
        "selector": "function",
        "format": ["camelCase", "PascalCase"]
      },
      {
        "selector": "parameter",
        "format": ["camelCase", "PascalCase"],
        "leadingUnderscore": "allow"
      },
      {
        "selector": "property",
        "format": ["camelCase", "PascalCase", "UPPER_CASE"],
        "leadingUnderscore": "allowDouble",
        "filter": {
          "regex": "^(Content-Type|Content-Encoding|Cache-Control|Authorization|Accept|[Xx]-[A-Za-z-]+|Access-Control-[A-Za-z-]+|--[a-z-]+|&::[a-z]+|day_[a-z_]+|[0-9a-f]+|.*[ /].*|[a-z]+/[a-z+-]+|[a-z-]+\\.[a-z_]+|[a-z0-9]+\\.[a-zA-Z]+|[a-z-]+-[a-z-]+|\\.[a-z]+|[+\\- ])$",
          "match": false
        }
      },
      {
        "selector": "typeLike",
        "format": ["PascalCase"]
      },
      {
        "selector": "typeProperty",
        "format": ["camelCase", "PascalCase"],
        "leadingUnderscore": "allowDouble",
        "filter": {
          "regex": "^(Content-Type|Authorization|Accept)$",
          "match": false
        }
      },
      {
        "selector": "enumMember",
        "format": ["PascalCase", "UPPER_CASE", "camelCase"]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/lib/orchestra/**/*.ts",
        "src/app/api/**/*.ts",
        "src/lib/user/**/*.ts",
        "src/lib/endpoints/**/*.ts",
        "src/lib/interfaces/**/*.ts",
        "src/lib/usage/**/*.ts",
        "src/types/usage/**/*.ts",
        "src/hooks/Usage/**/*.ts"
      ],
      "rules": {
        "@typescript-eslint/naming-convention": "off"
      }
    },
    {
      "files": ["src/tests/**/*.ts", "src/tests/**/*.tsx"],
      "rules": {
        "@typescript-eslint/naming-convention": "off"
      }
    },
    {
      "files": [
        "src/lib/user/billing/stripe/*.ts",
        "src/app/api/user/account-type/route.ts",
        "src/app/api/user/business-info/route.ts"
      ],
      "rules": {
        "@typescript-eslint/naming-convention": "off"
      }
    },
    {
      "files": [
        "src/**/Themes/**/*.ts",
        "src/**/Themes/**/*.js",
        "src/constants/**/*.ts",
        "src/components/UI/**/*.tsx",
        "src/utils/stripe/**/*.ts",
        "src/utils/interfaces/common.ts"
      ],
      "rules": {
        "@typescript-eslint/naming-convention": "off"
      }
    },
    {
      "files": ["vite-env.d.ts", "tailwind.config.ts"],
      "rules": {
        "@typescript-eslint/naming-convention": "off"
      }
    }
  ]
}
