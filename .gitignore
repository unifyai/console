# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# vitest / playwright screenshots
screenshots/
playwright-report/
test-results/

# generated test files (matrix test splits)
src/tests/**/generated/

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# API call logs
api-calls.log
.log-filter

# local env files
.env
.env.development
.env*.local
.env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# auth files
application_default_credentials.json
.idea/

# Local plans and credentials — anchored to repo root so the rule
# doesn't accidentally ignore real source under any nested ``plans/``
# directory (it was previously swallowing
# ``src/app/(home)/admin/plans/``, which made the route 404 in
# production while building locally).
/plans/
.credentials/
.cursorrules
/.cursor/projects/
/.cursor/plans/

# ON_PREM sandbox mock files (contain API keys)
public/sessionInfo.json
public/userInfo.json

# Workflow recording outputs
src/workflows/recordings/

# Service-account credential files
comm-sa.json

.design/