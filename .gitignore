# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# vitest / playwright screenshots
screenshots/
playwright-report/
test-results/

# generated test files (matrix test splits)
src/tests/**/generated/

# next.js
.next/
.next-stale-*/
/out/

# production
/build

# misc
.DS_Store
.claude/*
!.claude/settings.json
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# API call logs
api-calls.log
.log-filter

# local env files
.env
.env.development
.env*.local
.env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# auth files
application_default_credentials.json
.idea/

# Local plans and credentials — anchored to repo root so the rule
# doesn't accidentally ignore real source under any nested ``plans/``
# directory (it was previously swallowing
# ``src/app/(home)/admin/plans/``, which made the route 404 in
# production while building locally).
/plans/
.credentials/
.cursorrules
/.cursor/projects/
/.cursor/plans/

# ON_PREM sandbox mock files (contain API keys)
public/sessionInfo.json
public/userInfo.json

# Workflow recording outputs
src/workflows/recordings/

# Call-avatar preview harness (esbuild bundle + screenshot output)
scripts/call-avatar-harness/bundle.js
scripts/call-avatar-harness/bundle.css
/renders/
.avatar-harness/

# Service-account credential files. Globs, not exact names: these land in the
# repo root under whatever name the console/gcloud download gives them, and an
# unmatched one is a real key a single `git add -A` away from being published.
comm-sa.json
*_sa_credentials.json
*-sa-credentials.json
/saas-*.json

.design/
# call-avatar harness build artifacts
scripts/call-avatar-harness/bundle.*
scripts/call-avatar-harness/parity-bundle.*
